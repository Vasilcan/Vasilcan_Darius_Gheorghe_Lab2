@page
@model Vasilcan_Darius_Gheorghe_Lab2.Pages.Authors.IndexModel

@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Author[0].FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.Author[0].LastName)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Author)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
            </tr>
        }
    </tbody>
</table>