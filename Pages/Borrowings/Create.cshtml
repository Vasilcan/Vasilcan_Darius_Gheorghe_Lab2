@page
@model Vasilcan_Darius_Gheorghe_Lab2.Pages.Borrowings.CreateModel
@{ ViewData["Title"] = "Create Borrowing"; }
<h1>Create Borrowing</h1>
<form method="post" class="col-md-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Borrowing.MemberID" class="form-label">Member</label><select asp-for="Borrowing.MemberID" asp-items="Model.MemberList" class="form-select"><option value="">Select member</option></select></div>
    <div class="mb-3"><label asp-for="Borrowing.BookID" class="form-label">Book</label><select asp-for="Borrowing.BookID" asp-items="Model.BookList" class="form-select"><option value="">Select book</option></select></div>
    <div class="mb-3"><label asp-for="Borrowing.ReturnDate" class="form-label"></label><input asp-for="Borrowing.ReturnDate" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Create</button> <a asp-page="Index">Back to List</a>
</form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
