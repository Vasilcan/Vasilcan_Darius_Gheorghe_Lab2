@page
@model Vasilcan_Darius_Gheorghe_Lab2.Pages.Borrowings.DeleteModel
@{ ViewData["Title"] = "Delete Borrowing"; }
<h1>Delete Borrowing</h1>
<h3>Are you sure you want to delete this borrowing?</h3>
<dl class="row">
    <dt class="col-sm-2">Member</dt><dd class="col-sm-10">@Model.Borrowing.Member?.FullName</dd>
    <dt class="col-sm-2">Book</dt><dd class="col-sm-10">@Model.Borrowing.Book?.Title</dd>
    <dt class="col-sm-2">Author</dt><dd class="col-sm-10">@Model.Borrowing.Book?.Author?.FullName</dd>
    <dt class="col-sm-2">Return Date</dt><dd class="col-sm-10">@Model.Borrowing.ReturnDate.ToString("d")</dd>
</dl>
<form method="post"><input type="hidden" asp-for="Borrowing.ID" /><button type="submit" class="btn btn-danger">Delete</button> | <a asp-page="Index">Back to List</a></form>
