@page
@model Vasilcan_Darius_Gheorghe_Lab2.Pages.Members.CreateModel
@{ ViewData["Title"] = "Create Member"; }
<h1>Create Member</h1>
<form method="post" class="col-md-4">
    <div class="mb-3"><label asp-for="Member.FirstName" class="form-label"></label><input asp-for="Member.FirstName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Member.LastName" class="form-label"></label><input asp-for="Member.LastName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Member.Email" class="form-label"></label><input asp-for="Member.Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Member.Address" class="form-label"></label><input asp-for="Member.Address" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Member.Phone" class="form-label"></label><input asp-for="Member.Phone" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Create</button> <a asp-page="Index">Back to List</a>
</form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
